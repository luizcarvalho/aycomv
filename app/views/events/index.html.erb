<% content_for(:title, "Eventos — AYCOM Videos") %>

<div class="page-header">
  <h2 class="page-title">Eventos</h2>
  <div class="page-actions">
    <%= form_with url: events_path, method: :get, class: "form-inline" do |f| %>
      <div class="filter-toolbar">
        <%= f.select :modulo,
            options_for_select([
              ["Todos os Módulos", nil],
              ["Stream", "stream"],
              ["Video", "video"],
              ["Client", "client"],
              ["Notification", "notification"]
            ], params[:modulo]),
            {},
            { class: "filter-input", onchange: 'this.form.requestSubmit()' } %>

        <% if params[:object_id].present? %>
          <%= f.hidden_field :object_id, value: params[:object_id] %>
          <span class="filter-tag">
            ID: <%= params[:object_id] %>
            <%= link_to "✕", events_path(modulo: params[:modulo]), class: "filter-tag-remove" %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<p class="page-subtitle" style="margin-bottom: var(--space-4);"><%= @events.count %> eventos registrados</p>

<% if @events.any? %>
  <div class="events-table-wrapper">
    <table class="events-table">
      <thead>
        <tr>
          <th>Data/Hora</th>
          <th>Módulo</th>
          <th>Rótulo</th>
          <th>Valor</th>
          <th>Object ID</th>
          <th>Metadata</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td class="events-timestamp"><%= event.created_at.strftime("%d/%m/%Y %H:%M:%S") %></td>
            <td>
              <span class="events-badge events-badge-<%= event.modulo %>"><%= event.modulo %></span>
            </td>
            <td class="events-rotulo"><%= event.rotulo %></td>
            <td><%= event.valor %></td>
            <td>
              <% if event.object_id.present? %>
                <%= link_to event.object_id, events_path(modulo: event.modulo, object_id: event.object_id), class: "events-object-link" %>
              <% end %>
            </td>
            <td class="events-metadata">
              <% if event.metadata.present? && event.metadata.any? %>
                <code><%= event.metadata.to_json %></code>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  </div>
<% else %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <p>Nenhum evento registrado.</p>
  </div>
<% end %>
