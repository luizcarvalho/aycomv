<% content_for(:title, "Eventos — AYCOM Videos") %>

<div class="page-header">
  <h2 class="page-title">Eventos</h2>
</div>

<div class="events-filter-panel">
  <%= form_with url: events_path, method: :get, class: "events-filter-form" do |f| %>
    <div class="events-filter-grid">
      <div class="events-filter-group">
        <label class="events-filter-label">Módulo</label>
        <%= f.select :modulo,
            options_for_select([
              ["Todos", nil],
              ["Stream", "stream"],
              ["Video", "video"],
              ["Client", "client"],
              ["Notification", "notification"]
            ], params[:modulo]),
            {},
            { class: "events-filter-select", onchange: 'this.form.requestSubmit()' } %>
      </div>

      <div class="events-filter-group">
        <label class="events-filter-label">Rótulo</label>
        <%= f.text_field :rotulo,
            value: params[:rotulo],
            class: "events-filter-input",
            placeholder: "Buscar rótulo..." %>
      </div>

      <div class="events-filter-group">
        <label class="events-filter-label">Valor</label>
        <%= f.text_field :valor,
            value: params[:valor],
            class: "events-filter-input",
            placeholder: "Buscar valor..." %>
      </div>

      <div class="events-filter-group">
        <label class="events-filter-label">Cliente</label>
        <%= f.select :client_id,
            options_from_collection_for_select(Client.alphabetically, :id, :name, params[:client_id]),
            { include_blank: "Todos" },
            { class: "events-filter-select", onchange: 'this.form.requestSubmit()' } %>
      </div>

      <div class="events-filter-group">
        <label class="events-filter-label">Data de</label>
        <%= f.date_field :date_from,
            value: params[:date_from],
            class: "events-filter-input" %>
      </div>

      <div class="events-filter-group">
        <label class="events-filter-label">Data até</label>
        <%= f.date_field :date_to,
            value: params[:date_to],
            class: "events-filter-input" %>
      </div>
    </div>

    <div class="events-filter-actions">
      <%= f.submit "Filtrar", class: "btn btn-primary btn-sm" %>
      <%= link_to "Limpar", events_path, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>

<p class="events-count"><%= @events.count %> eventos encontrados</p>

<% if @events.any? %>
  <div class="events-table-wrapper">
    <table class="events-table">
      <thead>
        <tr>
          <th>Data/Hora</th>
          <th>Módulo</th>
          <th>Rótulo</th>
          <th>Valor</th>
          <th>Cliente</th>
          <th>Metadata</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr class="events-row">
            <td class="events-timestamp"><%= event.created_at.strftime("%d/%m/%Y %H:%M:%S") %></td>
            <td>
              <span class="events-badge events-badge-<%= event.modulo %>"><%= event.modulo %></span>
            </td>
            <td class="events-rotulo"><%= event.rotulo %></td>
            <td class="events-valor"><%= event.valor %></td>
            <td>
              <% if event.client.present? %>
                <%= link_to event.client.name, events_path(client_id: event.client_id), class: "events-object-link" %>
              <% end %>
            </td>
            <td class="events-metadata">
              <% if event.metadata.present? && event.metadata.any? %>
                <code><%= event.metadata.to_json %></code>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  </div>
<% else %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <p>Nenhum evento registrado.</p>
  </div>
<% end %>
