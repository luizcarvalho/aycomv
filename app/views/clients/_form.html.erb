<%= form_with model: client, class: "form" do |f| %>
  <% if client.errors.any? %>
    <div class="error_explanation">
      <h2><%= pluralize(client.errors.count, "erro") %> impediram que este cliente fosse salvo:</h2>

      <ul>
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="form-group">
    <%= f.label :name, "Nome", class: "form-label" %>
    <%= f.text_field :name, class: "form-input", placeholder: "Nome do cliente", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :email, "E-mail", class: "form-label" %>
    <%= f.text_field :email, class: "form-input", placeholder: "email1@exemplo.com.br, email2@exemplo.com.br", required: true %>
    <p class="form-hint">Separe múltiplos destinatários com vírgula.</p>
  </div>

  <div class="form-group">
    <label class="form-checkbox">
      <%= f.check_box :notify_on_generate, class: "checkbox-input" %>
      <span class="checkbox-label">Notificar por e-mail quando um vídeo for gerado</span>
    </label>
  </div>

  <div class="form-actions">
    <%= f.submit client.persisted? ? "Salvar Alterações" : "Cadastrar Cliente", class: "btn btn-primary" %>
    <%= link_to "Cancelar", clients_path, class: "btn btn-ghost" %>
  </div>
<% end %>
