<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "AYCOM Videos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Sistema de gerenciamento de timelapse RTMP">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AYCOM Videos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-layout">
      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <div class="logo">
            <img src="https://res.cloudinary.com/drlko5ghb/image/upload/v1770678369/DELETE/aycomlogo.png" alt="AYCOM Videos" class="logo-img">
          </div>
        </div>

        <nav class="sidebar-nav">
          <%= link_to root_path, class: "nav-link #{'active' if controller_name == 'dashboard'}" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            <span>Dashboard</span>
          <% end %>

          <%= link_to streams_path, class: "nav-link #{'active' if controller_name == 'streams'}" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><path d="M8.46 15.54a5 5 0 0 1 0-7.07"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M5.63 18.36a9 9 0 0 1 0-12.73"/><path d="M18.36 5.64a9 9 0 0 1 0 12.73"/></svg>
            <span>Streams</span>
          <% end %>

          <%= link_to videos_path, class: "nav-link #{'active' if controller_name == 'videos'}" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
            <span>Vídeos</span>
          <% end %>

          <%= link_to clients_path, class: "nav-link #{'active' if controller_name == 'clients'}" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Clientes</span>
          <% end %>

          <%= link_to events_path, class: "nav-link #{'active' if controller_name == 'events'}" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            <span>Eventos</span>
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <div class="sidebar-user">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="user-email"><%= Current.user&.email_address %></span>
          </div>
          <%= button_to session_path, method: :delete, class: "btn-logout" do %>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Sair</span>
          <% end %>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="main-content">
        <% if notice.present? %>
          <div class="flash flash-success" data-controller="flash">
            <div class="flash-content">
              <svg class="flash-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <p><%= notice %></p>
            </div>
            <button class="flash-close" data-action="click->flash#dismiss">✕</button>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash flash-error" data-controller="flash">
            <div class="flash-content">
              <svg class="flash-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <p><%= alert %></p>
            </div>
            <button class="flash-close" data-action="click->flash#dismiss">✕</button>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
