<div id="<%= dom_id(stream) %>" class="stream-card" data-controller="modal" data-action="keydown@window->modal#closeOnEscape">
  <div class="stream-preview">
    <% if stream.preview_url.present? %>
      <img src="<%= stream.preview_url %>" alt="<%= stream.name %>" loading="lazy">
    <% else %>
      <div class="stream-preview-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="m12 10 4 2-4 2z"/></svg>
        <span>Sem preview</span>
      </div>
    <% end %>
    <span class="status-badge status-<%= stream.status %>"><%= stream.status.capitalize %></span>
  </div>

  <div class="stream-body">
    <h4 class="stream-name"><%= stream.name %></h4>
    <p class="stream-client"><%= stream.client.name %></p>

    <% if stream.error_message.present? %>
      <p class="stream-error"><%= stream.error_message %></p>
    <% end %>

    <div class="stream-meta">
      <code class="stream-url" title="<%= stream.url %>"><%= "...#{stream.url[-20..]}" %></code>
    </div>

    <div class="stream-stats" style="margin-top: 0.5rem; display: flex; gap: 0.5rem; font-size: 0.75rem; color: var(--color-text-muted);">
      <span>Frames: <%= number_with_delimiter stream.frames_count %></span>
      <span>• Janela: <%= stream.capture_window_label %></span>
      <% if stream.last_frame_at %>
        <span>• <%= time_ago_in_words(stream.last_frame_at) %> atrás</span>
      <% end %>
      <% if stream.last_error_at %>
        <span class="text-danger">• Erro: <%= time_ago_in_words(stream.last_error_at) %> atrás</span>
      <% end %>
    </div>
  </div>

  <div class="stream-actions">
    <button class="btn btn-ghost btn-sm" data-action="click->modal#open">Detalhes</button>

    <%= button_to stream_status_toggle_path(stream),
          method: :post,
          class: "btn btn-sm #{stream.online? ? 'btn-warning' : 'btn-success'}",
          data: { turbo_confirm: stream.online? ? "Pausar #{stream.name}?" : "Ativar #{stream.name}?" } do %>
      <%= stream.online? ? "Pausar" : "Ativar" %>
    <% end %>

    <%= link_to "Ver Vídeos", videos_path(stream_id: stream.id), class: "btn btn-ghost btn-sm" %>
    <%= link_to "Editar", edit_stream_path(stream), class: "btn btn-ghost btn-sm" %>

    <%= button_to "Excluir", stream_path(stream),
          method: :delete,
          class: "btn btn-danger-ghost btn-sm",
          data: { turbo_confirm: "Excluir #{stream.name}? Esta ação é irreversível e removerá todos os frames e vídeos gerados." } %>
  </div>

  <div class="modal-overlay" data-modal-target="overlay" data-action="click->modal#closeOnBackdrop">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Detalhes do Stream</h3>
        <button class="modal-close" data-action="click->modal#close">✕</button>
      </div>
      <div class="modal-body">
        <div class="modal-detail-row">
          <span class="modal-detail-label">ID</span>
          <span class="modal-detail-value"><%= stream.id %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Nome</span>
          <span class="modal-detail-value"><%= stream.name %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Cliente</span>
          <span class="modal-detail-value"><%= stream.client.name %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Cliente ID</span>
          <span class="modal-detail-value"><%= stream.client_id %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">URL</span>
          <span class="modal-detail-value"><%= stream.url %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Status</span>
          <span class="modal-detail-value"><%= stream.status.capitalize %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Janela de compilação</span>
          <span class="modal-detail-value"><%= stream.capture_window_label %></span>
        </div>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Frames</span>
          <span class="modal-detail-value"><%= number_with_delimiter stream.frames_count %></span>
        </div>
        <% if stream.last_frame_at %>
          <div class="modal-detail-row">
            <span class="modal-detail-label">Último frame</span>
            <span class="modal-detail-value"><%= stream.last_frame_at.strftime("%d/%m/%Y %H:%M") %></span>
          </div>
        <% end %>
        <% if stream.last_error_at %>
          <div class="modal-detail-row">
            <span class="modal-detail-label">Último erro</span>
            <span class="modal-detail-value"><%= stream.last_error_at.strftime("%d/%m/%Y %H:%M") %></span>
          </div>
        <% end %>
        <% if stream.error_message.present? %>
          <div class="modal-detail-row">
            <span class="modal-detail-label">Mensagem de erro</span>
            <span class="modal-detail-value"><%= stream.error_message %></span>
          </div>
        <% end %>
        <% if stream.preview_url.present? %>
          <div class="modal-detail-row">
            <span class="modal-detail-label">Preview URL</span>
            <span class="modal-detail-value"><%= stream.preview_url %></span>
          </div>
        <% end %>
        <div class="modal-detail-row">
          <span class="modal-detail-label">Criado em</span>
          <span class="modal-detail-value"><%= stream.created_at.strftime("%d/%m/%Y %H:%M") %></span>
        </div>
      </div>
    </div>
  </div>
</div>
